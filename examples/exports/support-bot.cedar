// Generated by agent-policy-kit from policy 'support-bot-policy' (version 1).
// Do not edit by hand; change the YAML policy and export again.
//
// The action is expected in context: context.agent, context.tool,
// context.resource, and context.args (a record mirroring the
// action's args). Cedar has no approve decision, no rule order,
// and no clock; read the export warnings before relying on this
// file. Every lossy rule is listed there, and rules Cedar cannot
// express at all appear below as NOT EXPORTED comments.
// Policy default is deny: in Cedar, anything no permit
// matches is forbidden, so the default needs no policy.

// Knowledge base search is always safe.
@id("support-bot-policy.kb-search")
permit (principal, action, resource) when {
	context.tool == "kb.search"
};

// Read tickets assigned to the acting agent.
@id("support-bot-policy.read-own-ticket")
permit (principal, action, resource) when {
	context.tool == "tickets.read" && (context.args has "assignee" && context.args.assignee == context.agent)
};

// Comment on tickets assigned to the acting agent.
@id("support-bot-policy.comment-own-ticket")
permit (principal, action, resource) when {
	context.tool == "tickets.comment" && (context.args has "assignee" && context.args.assignee == context.agent)
};

// Refunds up to $200 go to a human, never straight through.
@id("support-bot-policy.small-refund-needs-approval")
forbid (principal, action, resource) when {
	context.tool == "refund.issue" && (context.args has "amount" && context.args.amount <= 200)
};

// Refunds over $200 are out of scope for this bot.
@id("support-bot-policy.large-refund-denied")
forbid (principal, action, resource) when {
	context.tool == "refund.issue" && (context.args has "amount" && context.args.amount > 200)
};

// The bot must never touch user accounts.
@id("support-bot-policy.no-user-management")
forbid (principal, action, resource) when {
	context.tool like "users.*"
};
