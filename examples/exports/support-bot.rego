package agentpolicykit.support_bot_policy

rules := [
	{"name": "kb-search", "decision": "allow"},
	{"name": "read-own-ticket", "decision": "allow"},
	{"name": "comment-own-ticket", "decision": "allow"},
	{"name": "small-refund-needs-approval", "decision": "approve"},
	{"name": "large-refund-denied", "decision": "deny"},
	{"name": "no-user-management", "decision": "deny"}
]

default result := {"decision": "deny", "rule": null}

result := {"decision": rules[i].decision, "rule": rules[i].name} if {
	i := min(matched)
}

matched contains 0 if {
	input.tool == "kb.search"
}

matched contains 1 if {
	input.tool == "tickets.read"
	input.args.assignee == input.agent
}

matched contains 2 if {
	input.tool == "tickets.comment"
	input.args.assignee == input.agent
}

