{"id": "sb-01", "policy": "support-bot-policy", "action": {"agent": "support-bot", "tool": "kb.search", "args": {"q": "refund policy"}}, "expected": "allow", "note": "KB search is always allowed."}
{"id": "sb-02", "policy": "support-bot-policy", "action": {"agent": "support-bot", "tool": "tickets.read", "args": {"ticket": "T-1042", "assignee": "support-bot"}}, "expected": "allow", "note": "Reading a ticket assigned to the acting agent."}
{"id": "sb-03", "policy": "support-bot-policy", "action": {"agent": "support-bot", "tool": "tickets.read", "args": {"ticket": "T-1043", "assignee": "other-bot"}}, "expected": "deny", "note": "Someone else's ticket is out of bounds."}
{"id": "sb-04", "policy": "support-bot-policy", "action": {"agent": "support-bot", "tool": "tickets.comment", "args": {"ticket": "T-1042", "assignee": "support-bot", "text": "looking into it"}}, "expected": "allow", "note": "Commenting on own ticket."}
{"id": "sb-05", "policy": "support-bot-policy", "action": {"agent": "support-bot", "tool": "tickets.comment", "args": {"ticket": "T-1043", "assignee": "other-bot", "text": "hi"}}, "expected": "deny", "note": "Commenting on someone else's ticket."}
{"id": "sb-06", "policy": "support-bot-policy", "action": {"agent": "support-bot", "tool": "refund.issue", "args": {"ticket": "T-1042", "amount": 50, "currency": "USD"}}, "expected": "approve", "note": "Small refund goes to a human."}
{"id": "sb-07", "policy": "support-bot-policy", "action": {"agent": "support-bot", "tool": "refund.issue", "args": {"ticket": "T-1042", "amount": 200, "currency": "USD"}}, "expected": "approve", "note": "Boundary: 200 is still the small-refund rule (lte)."}
{"id": "sb-08", "policy": "support-bot-policy", "action": {"agent": "support-bot", "tool": "refund.issue", "args": {"ticket": "T-1042", "amount": 201, "currency": "USD"}}, "expected": "deny", "note": "Boundary: 201 trips the large-refund deny."}
{"id": "sb-09", "policy": "support-bot-policy", "action": {"agent": "support-bot", "tool": "refund.issue", "args": {"ticket": "T-1042", "amount": 5000, "currency": "USD"}}, "expected": "deny", "note": "Large refund is out of scope for the bot."}
{"id": "sb-10", "policy": "support-bot-policy", "action": {"agent": "support-bot", "tool": "users.delete", "args": {"user": "u-99"}}, "expected": "deny", "note": "User management is never allowed."}
{"id": "sb-11", "policy": "support-bot-policy", "action": {"agent": "support-bot", "tool": "users.update", "args": {"user": "u-99", "role": "admin"}}, "expected": "deny", "note": "The users.* glob catches every user tool."}
{"id": "sb-12", "policy": "support-bot-policy", "action": {"agent": "support-bot", "tool": "tickets.read", "args": {"ticket": "T-1042"}}, "expected": "deny", "note": "Missing assignee cannot prove ownership, so deny."}
{"id": "sb-13", "policy": "support-bot-policy", "action": {"agent": "support-bot", "tool": "refund.issue", "args": {"ticket": "T-1042", "currency": "USD"}}, "expected": "deny", "note": "Missing amount matches neither refund rule; default deny."}
{"id": "sb-14", "policy": "support-bot-policy", "action": {"agent": "support-bot", "tool": "billing.view", "args": {"account": "a-1"}}, "expected": "deny", "note": "No rule covers billing; default deny."}
{"id": "sb-15", "policy": "support-bot-policy", "action": {"agent": "support-bot", "tool": "tickets.read", "args": {"ticket": "T-9000", "assignee": "support-bot"}}, "expected": "allow", "note": "The {agent} placeholder works for any ticket id."}
{"id": "sb-16", "policy": "support-bot-policy", "action": {"agent": "support-bot", "tool": "refund.issue", "args": {"ticket": "T-1042", "amount": 0, "currency": "USD"}}, "expected": "approve", "note": "Zero-amount refund still routes to a human."}
{"id": "db-01", "policy": "deploy-bot-policy", "action": {"agent": "deploy-bot", "tool": "logs.tail", "args": {"service": "api"}}, "expected": "allow", "note": "Log tailing is read-only."}
{"id": "db-02", "policy": "deploy-bot-policy", "action": {"agent": "deploy-bot", "tool": "ci.rerun", "args": {"pipeline": "main"}}, "expected": "allow", "note": "The ci.* glob covers reruns."}
{"id": "db-03", "policy": "deploy-bot-policy", "action": {"agent": "deploy-bot", "tool": "ci.status", "args": {"pipeline": "main"}}, "expected": "allow", "note": "Status checks are safe."}
{"id": "db-04", "policy": "deploy-bot-policy", "now": "2026-09-27T10:00:00+00:00", "action": {"agent": "deploy-bot", "tool": "deploy", "args": {"env": "staging", "ref": "abc123"}}, "expected": "approve", "note": "Staging deploy needs approval at any hour."}
{"id": "db-05", "policy": "deploy-bot-policy", "now": "2026-09-27T03:00:00+00:00", "action": {"agent": "deploy-bot", "tool": "deploy", "args": {"env": "staging", "ref": "abc123"}}, "expected": "approve", "note": "3am staging deploy still only needs approval, not a deny."}
{"id": "db-06", "policy": "deploy-bot-policy", "now": "2026-09-27T10:00:00+00:00", "action": {"agent": "deploy-bot", "tool": "deploy", "args": {"env": "prod", "ref": "abc123"}}, "expected": "approve", "note": "Prod deploy inside 09:00-17:00 goes to a human."}
{"id": "db-07", "policy": "deploy-bot-policy", "now": "2026-09-27T08:59:00+00:00", "action": {"agent": "deploy-bot", "tool": "deploy", "args": {"env": "prod", "ref": "abc123"}}, "expected": "deny", "note": "One minute before the window opens: denied."}
{"id": "db-08", "policy": "deploy-bot-policy", "now": "2026-09-27T17:00:00+00:00", "action": {"agent": "deploy-bot", "tool": "deploy", "args": {"env": "prod", "ref": "abc123"}}, "expected": "deny", "note": "Window end is exclusive; 17:00 is denied."}
{"id": "db-09", "policy": "deploy-bot-policy", "now": "2026-09-27T02:00:00+00:00", "action": {"agent": "deploy-bot", "tool": "deploy", "args": {"env": "prod", "ref": "abc123"}}, "expected": "deny", "note": "Night-time prod deploy is denied outright."}
{"id": "db-10", "policy": "deploy-bot-policy", "action": {"agent": "deploy-bot", "tool": "db.migrate", "args": {"env": "staging"}}, "expected": "deny", "note": "Migrations are never automated, even on staging."}
{"id": "db-11", "policy": "deploy-bot-policy", "action": {"agent": "deploy-bot", "tool": "db.migrate", "args": {"env": "prod"}}, "expected": "deny", "note": "Migrations on prod are denied."}
{"id": "db-12", "policy": "deploy-bot-policy", "now": "2026-09-27T10:00:00+00:00", "action": {"agent": "deploy-bot", "tool": "deploy", "args": {"ref": "abc123"}}, "expected": "deny", "note": "Deploy with no env matches no rule; default deny."}
{"id": "db-13", "policy": "deploy-bot-policy", "action": {"agent": "deploy-bot", "tool": "ssh.exec", "args": {"host": "prod-1", "cmd": "uptime"}}, "expected": "deny", "note": "No rule covers ssh; default deny."}
{"id": "db-14", "policy": "deploy-bot-policy", "now": "2026-09-27T12:30:00+00:00", "action": {"agent": "deploy-bot", "tool": "deploy", "args": {"env": "prod", "ref": "def456"}}, "expected": "approve", "note": "Midday prod deploy needs a human."}
{"id": "db-15", "policy": "deploy-bot-policy", "now": "2026-09-27T10:00:00+00:00", "action": {"agent": "deploy-bot", "tool": "deploy", "args": {"env": "dev", "ref": "abc123"}}, "expected": "deny", "note": "Unknown env is not staging or prod; default deny."}
{"id": "db-16", "policy": "deploy-bot-policy", "action": {"agent": "deploy-bot", "tool": "logs.tail", "args": {"service": "api"}, "resource": "logs/prod"}, "expected": "allow", "note": "Extra fields like resource do not disturb matching."}
{"id": "da-01", "policy": "data-analyst-policy", "action": {"agent": "analyst", "tool": "notebook.run", "args": {"cell": "df.head()"}}, "expected": "allow", "note": "Notebook runs are local and safe."}
{"id": "da-02", "policy": "data-analyst-policy", "action": {"agent": "analyst", "tool": "warehouse.query", "args": {"table": "orders", "row_limit": 1000}}, "expected": "allow", "note": "Small query on a clean table."}
{"id": "da-03", "policy": "data-analyst-policy", "action": {"agent": "analyst", "tool": "warehouse.query", "args": {"table": "customers_pii", "row_limit": 10}}, "expected": "deny", "note": "PII table denied even for tiny queries; the PII rule runs first."}
{"id": "da-04", "policy": "data-analyst-policy", "action": {"agent": "analyst", "tool": "warehouse.query", "args": {"table": "events", "row_limit": 500000}}, "expected": "approve", "note": "Big scan on a clean table goes to a human."}
{"id": "da-05", "policy": "data-analyst-policy", "action": {"agent": "analyst", "tool": "warehouse.query", "args": {"table": "events_pii", "row_limit": 500000}}, "expected": "deny", "note": "Big scan on a PII table is denied, not approved; order matters."}
{"id": "da-06", "policy": "data-analyst-policy", "action": {"agent": "analyst", "tool": "warehouse.export", "args": {"table": "orders", "dest": "s3://bucket/x.csv"}}, "expected": "deny", "note": "Exports never leave the warehouse."}
{"id": "da-07", "policy": "data-analyst-policy", "action": {"agent": "analyst", "tool": "warehouse.query", "args": {"row_limit": 10}}, "expected": "deny", "note": "Query with no table matches no rule; default deny."}
{"id": "da-08", "policy": "data-analyst-policy", "action": {"agent": "analyst", "tool": "warehouse.query", "args": {"table": "orders"}}, "expected": "deny", "note": "Query with no row limit cannot prove it is small; denied."}
{"id": "da-09", "policy": "data-analyst-policy", "action": {"agent": "analyst", "tool": "warehouse.drop_table", "args": {"table": "scratch"}}, "expected": "deny", "note": "No rule covers destructive tools; default deny."}
{"id": "da-10", "policy": "data-analyst-policy", "action": {"agent": "analyst", "tool": "notebook.run", "args": {"cell": "train(model)", "timeout": 3600}}, "expected": "allow", "note": "Notebook args do not change the decision."}
{"id": "da-11", "policy": "data-analyst-policy", "action": {"agent": "analyst", "tool": "warehouse.query", "args": {"table": "audit_log", "row_limit": 50}}, "expected": "allow", "note": "audit_log does not end in _pii, so it is a clean table."}
{"id": "da-12", "policy": "data-analyst-policy", "action": {"agent": "analyst", "tool": "warehouse.query", "args": {"table": "users_pii", "row_limit": 1}}, "expected": "deny", "note": "One row of PII is still PII."}
{"id": "da-13", "policy": "data-analyst-policy", "action": {"agent": "analyst", "tool": "warehouse.query", "args": {"table": "orders", "row_limit": 100000}}, "expected": "allow", "note": "Boundary: 100000 is still small (lte)."}
{"id": "da-14", "policy": "data-analyst-policy", "action": {"agent": "analyst", "tool": "warehouse.query", "args": {"table": "orders", "row_limit": 100001}}, "expected": "approve", "note": "Boundary: 100001 trips the big-scan approval."}
{"id": "da-15", "policy": "data-analyst-policy", "action": {"agent": "analyst", "tool": "data.share", "args": {"with": "partner@example.com"}}, "expected": "deny", "note": "No rule covers sharing; default deny."}
{"id": "da-16", "policy": "data-analyst-policy", "action": {"agent": "analyst", "tool": "warehouse.query", "args": {"table": "ORDERS", "row_limit": 5}}, "expected": "allow", "note": "The PII regex is case-sensitive; ORDERS has no _pii suffix."}
